# Change ONLY this value to switch Gemini / OpenAI automatically.
# Gemini key starts with AIza; OpenAI key starts with sk-.
AI_API_KEY=PASTE_YOUR_API_KEY_HERE

# Optional model settings (used automatically for the corresponding provider).
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4o-mini

# Voice recognition disabled; TTS removed
STT_PROVIDER=mock
TTS_PROVIDER=mock
PORT=25565
CHROMA_URL=http://127.0.0.1:8000
CHROMA_COLLECTION=study_materials
MEMORY_DB=server/store/memory.db
